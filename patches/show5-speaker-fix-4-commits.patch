Subject: [PATCH 3/4] Show 5: keep MAX98396 GLOBAL_EN active across playbacks
 (re-enable fails)

---
 sound/soc/codecs/max98396.c | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/sound/soc/codecs/max98396.c b/sound/soc/codecs/max98396.c
index ab1ea888..089e005d 100644
--- a/sound/soc/codecs/max98396.c
+++ b/sound/soc/codecs/max98396.c
@@ -662,8 +662,10 @@ static int max98396_dac_event(struct snd_soc_dapm_widget *w,
 			MAX98396_R205E_PCM_RX_EN,
 			MAX98396_PCM_RX_EN_MASK, 0);
 
-		regmap_write(max98396->regmap,
-			MAX98396_R210F_GLOBAL_EN, 0);
+		/* 2026-09-01: DO NOT write GLOBAL_EN=0 here. The amp refuses to
+		 * re-enter the active state afterwards (EN=1 write is ignored —
+		 * observed: first playback powers up fine, all later ones fail).
+		 * Leave the amp active; the idle draw is negligible. */
 		max98396->tdm_mode = false;
 		break;
 	default:
